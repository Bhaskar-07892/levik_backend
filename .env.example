NODE_ENV=development
# development | staging | production (defaults to production when NODE_ENV=production). Only production disables
# test OTP codes and /api/docs, so a hosted staging API can run NODE_ENV=production with APP_ENV=staging.
APP_ENV=development
PORT=4100
API_PREFIX=api
CORS_ORIGINS=http://localhost:3020,http://localhost:3000,http://localhost:8081

# Local Postgres:
DATABASE_URL=postgres://postgres:postgres@localhost:5432/levik
DB_SSL=false
# Neon (your own dev branch): pooled URL for the app, direct URL (host without "-pooler") for migrations/seeding.
# DATABASE_URL=postgresql://<role>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require
# DATABASE_MIGRATION_URL=postgresql://<role>:<password>@<endpoint>.<region>.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require
# DB_SSL=true
DB_LOGGING=false
# true = apply pending migrations at app start. Use false with a pooler and run `npm run migration:run` instead.
DB_RUN_MIGRATIONS=true
# `npm run db:reset` only wipes local databases unless this is true (only for your own disposable branch).
ALLOW_DB_RESET=false
DB_POOL_SIZE=10

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
JWT_ISSUER=levik-api
JWT_AUDIENCE=levik-clients

OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
# Development/testing only (ignored when NODE_ENV=production)
OTP_TEST_CODES=919829011234:123456,919829041127:123456,919900011122:123456
# One code for EVERY number, no SMS sent (test environments only; ignored when APP_ENV=production). Empty = off.
TEST_OTP=
SMS_PROVIDER=console
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=

# Signs QR labels so counterfeit codes can be detected. Never change after labels are printed.
QR_SIGNING_SECRET=change-me-to-another-long-random-secret-32-chars
QR_BASE_URL=https://levik.in/v

# local = files under STORAGE_DIR (development). s3 = an S3-compatible bucket (see DEPLOYMENT.md → File storage).
STORAGE_DRIVER=local
STORAGE_DIR=./storage
# S3_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=levik-staging-uploads
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
UPLOAD_MAX_MB=10
